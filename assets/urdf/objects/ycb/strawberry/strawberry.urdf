<?xml version="1.0" ?>
<robot name="strawberry">
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="strawberry.stl" scale="1.2 1.2 1.2"/>
      </geometry>
      <material name="auto_color">
        <color rgba="0.8 0.2 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="strawberry.stl" scale="1.2 1.2 1.2"/>
      </geometry>
    </collision>
  </link>
</robot>

  